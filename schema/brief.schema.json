{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooharahiroki1-jpg.github.io/aichiweb/schema/brief.schema.json",
  "title": "7AM PARALLAX daily deep-research brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "language",
    "report_title",
    "deck",
    "theme_a",
    "theme_b",
    "theme_ai"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "language": {"const": "ja-JP"},
    "report_title": {"type": "string", "minLength": 1, "maxLength": 100},
    "deck": {"type": "string", "minLength": 1, "maxLength": 240},
    "theme_a": {
      "allOf": [
        {"$ref": "#/$defs/theme"},
        {
          "properties": {
            "id": {"const": "A"},
            "kind": {"const": "now"}
          }
        }
      ]
    },
    "theme_b": {
      "allOf": [
        {"$ref": "#/$defs/theme"},
        {
          "properties": {
            "id": {"const": "B"},
            "kind": {"const": "timeless"}
          }
        }
      ]
    },
    "theme_ai": {
      "allOf": [
        {"$ref": "#/$defs/theme"},
        {
          "required": ["angles"],
          "properties": {
            "id": {"const": "AI"},
            "kind": {"const": "ai"},
            "angles": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "technology",
                  "ethics",
                  "philosophy",
                  "thought_experiment",
                  "economics",
                  "development_competition",
                  "labor",
                  "governance",
                  "safety",
                  "culture",
                  "environment"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "subtitle",
        "abstract",
        "visual",
        "key_points",
        "sections",
        "reflection_questions",
        "sources"
      ],
      "properties": {
        "id": {"enum": ["A", "B", "AI"]},
        "kind": {"enum": ["now", "timeless", "ai"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "subtitle": {"type": "string", "minLength": 1, "maxLength": 240},
        "abstract": {"type": "string", "minLength": 80, "maxLength": 1800},
        "visual": {"$ref": "#/$defs/visual"},
        "angles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "key_points": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 320}
        },
        "sections": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/section"}
        },
        "reflection_questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "sources": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "caption", "nodes"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "caption": {"type": "string", "minLength": 1, "maxLength": 260},
        "nodes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "value", "detail"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 50},
              "value": {"type": "string", "minLength": 1, "maxLength": 60},
              "detail": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "body", "source_refs"],
      "properties": {
        "heading": {"type": "string", "minLength": 1, "maxLength": 160},
        "body": {"type": "string", "minLength": 80, "maxLength": 12000},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 300},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 120},
        "published_at": {"type": "string", "format": "date"},
        "accessed_at": {"type": "string", "format": "date"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    }
  }
}

